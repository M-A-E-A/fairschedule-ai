BACKEND_CORS_ORIGINS=http://localhost:5173
APP_ENV=development
JWT_SECRET=replace-me-development-secret
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fairschedule
# Wall-clock budget in seconds for the schedule solver (S-01). Generation
# returns within this budget even for large institutions; if the solver cannot
# finish in time it reports status UNKNOWN and serves the deterministic
# fallback schedule instead of hanging the request.
SOLVER_TIME_LIMIT_SECONDS=10
AI_PROVIDER=none
AI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
